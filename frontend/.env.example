# Backend base URL. Leave blank to use same-origin (e.g. behind a proxy).
# Example (production): https://api.example.com
VITE_API_URL=

# Optional error monitoring (plan §19). Leave blank to disable.
VITE_SENTRY_DSN=

# Google Cloud Identity Platform / Firebase web app configuration.
# Leave all four blank to hide Google sign-in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
