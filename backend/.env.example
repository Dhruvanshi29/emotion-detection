# === Core ===
APP_ENV=development
APP_ROLE=web
APP_PORT=8000
LOG_LEVEL=INFO
# Surfaced in /health for deploy verification.
APP_VERSION=0.1.0
# Set by CI/CD to the deploy commit (e.g. GitHub Actions ${{ github.sha }}).
GIT_SHA=

# === Phase 14: production wiring ===
# Comma-separated list of frontend origins. REQUIRED when APP_ENV=production.
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=
# Optional error monitoring (plan §19). Leave blank to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# === Database ===
# Local dev default (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Neon Postgres example:
# You may paste Neon's standard pooled URL as-is; the app normalizes it for asyncpg.
# DATABASE_URL=postgresql://user:pass@host-pooler.neon.tech/dbname?sslmode=require&channel_binding=require
DB_ECHO=false

# === Auth / JWT ===
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30
AUTH_COOKIE_NAME=saaya_refresh
CSRF_COOKIE_NAME=saaya_csrf
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
FRONTEND_URL=http://localhost:5173

# Required in production. Generate 32 bytes as hex:
# python -c "import secrets; print(secrets.token_hex(32))"
FIELD_ENCRYPTION_KEY=

# Optional SMTP provider for verification, recovery, and reminder email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# Optional browser push notifications (VAPID key pair).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Verified Saaya accounts allowed to curate therapist profiles.
THERAPIST_ADMIN_EMAILS=

# === Google Cloud Identity Platform (optional Google sign-in) ===
# Must match VITE_FIREBASE_PROJECT_ID in the frontend.
GOOGLE_IDENTITY_PLATFORM_PROJECT_ID=

# === LLM Provider selection ===
# Comma-separated fallback chain, tried in order.
# Supported: nvidia, openrouter, groq, gemini
LLM_PROVIDER_CHAIN=groq,openrouter,nvidia,gemini

# Optional OpenAI-compatible semantic embeddings. Without these, Saaya uses
# its deterministic local private fallback.
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# === NVIDIA NIM (build.nvidia.com — free tier) ===
# Get key: https://build.nvidia.com/  -> "Get API Key"
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# For reasoning models (Kimi-K3, DeepSeek-R1, etc.): low | medium | high | max
# Leave blank for non-reasoning models. Higher = slower, better quality.
NVIDIA_REASONING_EFFORT=

# === OpenRouter (openrouter.ai — free-tier models available) ===
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any ":free" model from https://openrouter.ai/models?q=free
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_APP_URL=http://localhost:8000
OPENROUTER_APP_NAME=EmotionalWellnessDev

# === Groq (console.groq.com — free tier, very fast) ===
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# === Google Gemini (aistudio.google.com — free tier) ===
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash

# === Generation defaults ===
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
